---
displayMode: compact
---
gantt
    dateFormat x
    axisFormat %s
    title One-way layer lock ( A1: ② | A2: any actions except layer actions )
    section ㅤ
    Press: milestone, done, 1000, 1000
    Release: milestone, done, 2000, 2000
    Press: milestone, done, 3000, 3000
    Release: milestone, done, 4000, 4000
    tickInterval 1day
    section ㅤㅤ
    A1: 0, 1000
    A2: active, 1000, 5000
