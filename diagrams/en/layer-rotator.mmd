---
displayMode: compact
---
gantt
    dateFormat x
    axisFormat %s
    title Layer rotator ( A1: ② | A2: ③ | A3: ① )
    section ㅤ
    Press: milestone, done, 1000, 1000
    Release: milestone, done, 2000, 2000
    Press: milestone, done, 3000, 3000
    Release: milestone, done, 4000, 4000
    Press: milestone, done, 5000, 5000
    Release: milestone, done, 6000, 6000
    tickInterval 1day
    section ㅤㅤ
    A1: 0, 1s
    A2: active, 1000, 2s
    A3: crit, 3000, 2s
    A1: 5000, 2s
